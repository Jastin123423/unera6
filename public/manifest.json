{
  "name": "UNERA Social",
  "short_name": "UNERA",
  "description": "Connect with friends and the world around you on UNERA Social",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#18191A",
  "theme_color": "#1877F2",
  "orientation": "portrait",
  "scope": "/",
  "lang": "en",
  "dir": "ltr",
  "categories": ["social", "communication"],
  "prefer_related_applications": false,
  "related_applications": [],
  
  "icons": [
    {
      "src": "https://media.unera.social/e6fdc17a-b364-436d-8da8-3a96dc98c251.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "https://media.unera.social/a7d8ff6c-01b8-459f-8f6c-4f012fda59da.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "https://media.unera.social/e6fdc17a-b364-436d-8da8-3a96dc98c251.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],

  "screenshots": [
    {
      "src": "https://media.unera.social/screenshot1.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Home Feed"
    }
  ],

  "shortcuts": [
    {
      "name": "Feed",
      "short_name": "Feed",
      "description": "View your feed",
      "url": "/",
      "icons": [{ "src": "https://media.unera.social/e6fdc17a-b364-436d-8da8-3a96dc98c251.png", "sizes": "192x192" }]
    },
    {
      "name": "Notifications",
      "short_name": "Notifs",
      "description": "View notifications",
      "url": "/notifications",
      "icons": [{ "src": "https://media.unera.social/e6fdc17a-b364-436d-8da8-3a96dc98c251.png", "sizes": "192x192" }]
    },
    {
      "name": "Messages",
      "short_name": "Chat",
      "description": "View messages",
      "url": "/messages",
      "icons": [{ "src": "https://media.unera.social/e6fdc17a-b364-436d-8da8-3a96dc98c251.png", "sizes": "192x192" }]
    }
  ],

  "permissions": [
    "notifications",
    "push"
  ],

  "gcm_sender_id": "YOUR_FIREBASE_SENDER_ID", // You'll get this from Firebase Console
  "gcm_user_visible_only": true,

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": ["image/*"]
        }
      ]
    }
  },

  "launch_handler": {
    "client_mode": ["navigate-existing", "auto"]
  },

  "edge_side_panel": {
    "preferred_width": 480
  },

  "protocol_handlers": [
    {
      "protocol": "web+unera",
      "url": "/post?url=%s"
    }
  ],

  "url_handlers": ["https://unera.social/*"]
}
